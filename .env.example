# Radio Free Luna - AI DJ System Configuration
# Copy this file to .env and customize with your settings

# =============================================================================
# CORE CONFIGURATION
# =============================================================================

# OpenAI API Configuration (REQUIRED)
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# Music Library Configuration (REQUIRED)
# Comma-separated paths to your music directories
MUSIC_DIRECTORIES=/path/to/music1,/path/to/music2
SUPPORTED_FORMATS=mp3,flac,wav,m4a,ogg,wma
SCAN_RECURSIVE=true

# Database Configuration
DATABASE_URL=sqlite:///data/radio_free_luna.db
# For PostgreSQL: postgresql://user:password@localhost/radio_free_luna
# For MySQL: mysql://user:password@localhost/radio_free_luna

# =============================================================================
# DJ PERSONALITY & BEHAVIOR
# =============================================================================

# DJ Personality Style
# Options: conversational, classic_radio, contemplative, philosophical
DJ_PERSONALITY=conversational

# Knowledge and Commentary Depth
# Options: light, moderate, deep, philosophical
KNOWLEDGE_DEPTH=deep

# Commentary Generation Settings
ENABLE_COMMENTARY=true
COMMENTARY_FREQUENCY=moderate  # light, moderate, frequent
CONTEXTUAL_AWARENESS=true

# =============================================================================
# VOICE SYNTHESIS (TTS-WebUI Integration)
# =============================================================================

# TTS-WebUI Server Configuration
TTS_WEBUI_URL=http://localhost:7860
TTS_WEBUI_API_KEY=not_required_for_tts_webui
TTS_ENABLED=true

# Voice Model Selection
# Options: alloy, echo, fable, nova, onyx, shimmer
TTS_VOICE_MODEL=alloy

# Voice Settings
TTS_SPEED=1.0
TTS_PITCH=0.0
TTS_VOLUME=0.8

# Context-Aware Voice Adaptation
ADAPTIVE_VOICE=true
MORNING_VOICE=nova      # Bright, energetic
AFTERNOON_VOICE=alloy   # Balanced, versatile
EVENING_VOICE=shimmer   # Warm, expressive
NIGHT_VOICE=echo        # Soft, intimate

# =============================================================================
# CONTEXTUAL AWARENESS
# =============================================================================

# Location Settings
LOCATION=Denver, CO
TIMEZONE=America/Denver
COUNTRY_CODE=US

# Weather Integration — uses the keyless Open-Meteo API; no key needed.
# WEATHER_API_KEY is legacy and ignored.
WEATHER_ENABLED=true
WEATHER_UPDATE_INTERVAL=15  # minutes

# Genius API for Lyrics (Optional)
GENIUS_API_TOKEN=your_genius_api_token_here
GENIUS_ENABLED=true

# =============================================================================
# STREAMING & AUDIO
# =============================================================================

# Audio Streaming Configuration
STREAMING_ENABLED=false  # Set to true when streaming is implemented
STREAM_QUALITY=high      # low, medium, high
SAMPLE_RATE=44100
BIT_RATE=320

# Icecast Integration (For future audio streaming)
ICECAST_HOST=localhost
ICECAST_PORT=8000
ICECAST_PASSWORD=ChangeMe-Example-1234
ICECAST_MOUNT=/ai_dj_stream

# Audio Processing
NORMALIZE_AUDIO=true
CROSSFADE_DURATION=3.0   # seconds
AUTO_GAIN_CONTROL=true

# =============================================================================
# SERVER & API CONFIGURATION
# =============================================================================

# Server Settings
HOST=0.0.0.0
PORT=8080
DEBUG=false
RELOAD=false

# API Settings
API_PREFIX=/api
API_DOCS_ENABLED=true
API_RATE_LIMIT=100  # requests per minute

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_CREDENTIALS=true

# =============================================================================
# CACHING & PERFORMANCE
# =============================================================================

# Redis Configuration (Optional, for caching)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false
CACHE_TTL=3600  # seconds

# AI Analysis Caching
CACHE_AI_ANALYSIS=true
CACHE_LYRICS=true
CACHE_CONTEXT=true

# Performance Settings
MAX_CONCURRENT_ANALYSIS=3
FILE_SCAN_INTERVAL=300    # seconds
CONTEXT_UPDATE_INTERVAL=900  # seconds (15 minutes)

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/radio_free_luna.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5
LOG_FORMAT=detailed  # simple, detailed, json

# Enable specific component logging
LOG_AI_ANALYSIS=true
LOG_CONTEXT_CHANGES=true
LOG_FILE_OPERATIONS=true
LOG_API_REQUESTS=true

# Health Monitoring
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60  # seconds
METRICS_ENABLED=false

# =============================================================================
# ADVANCED FEATURES
# =============================================================================

# Music Analysis Settings
DEEP_ANALYSIS_ENABLED=true
ANALYZE_LYRICS=true
ANALYZE_AUDIO_FEATURES=false  # Requires librosa
DETECT_DUPLICATES=true

# Session Management
MAX_SESSION_DURATION=480  # minutes (8 hours)
DEFAULT_SESSION_DURATION=60  # minutes
ENERGY_FLOW_OPTIMIZATION=true
THEME_CONSISTENCY_WEIGHT=0.35
CONTEXT_RELEVANCE_WEIGHT=0.25

# Social Features (Future)
SOCIAL_FEATURES_ENABLED=false
COLLABORATIVE_PLAYLISTS=false
LISTENING_ANALYTICS=false

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================

# Development Settings
DEV_MODE=false
MOCK_AI_RESPONSES=false
MOCK_WEATHER_DATA=false
SKIP_FILE_VALIDATION=false

# Testing Configuration
TEST_MUSIC_DIRECTORY=/path/to/test/music
TEST_DATABASE_URL=sqlite:///test.db
ENABLE_TEST_ENDPOINTS=false

# =============================================================================
# SECURITY
# =============================================================================

# Security Settings
SECRET_KEY=your_secret_key_for_sessions_here
ENABLE_AUTHENTICATION=false
ADMIN_PASSWORD=your_admin_password_here

# API Security
API_KEY_REQUIRED=false
API_KEY=your_api_key_here
RATE_LIMITING_ENABLED=true

# File Access Security
RESTRICT_FILE_ACCESS=true
ALLOWED_EXTENSIONS=mp3,flac,wav,m4a,ogg,wma
MAX_FILE_SIZE=100MB

# =============================================================================
# DEPLOYMENT
# =============================================================================

# Docker Configuration
DOCKER_MUSIC_MOUNT=/app/music
DOCKER_DATA_MOUNT=/app/data
DOCKER_LOGS_MOUNT=/app/logs

# Deployment Environment
ENVIRONMENT=development  # development, staging, production
VERSION=1.0.0

# Resource Limits
MAX_MEMORY_USAGE=2GB
MAX_CPU_USAGE=80
MAX_DISK_SPACE=10GB

# =============================================================================
# EXAMPLE VALUES FOR QUICK SETUP
# =============================================================================

# Uncomment and modify these for a quick development setup:

# OPENAI_API_KEY=sk-1234567890abcdef
# MUSIC_DIRECTORIES=/home/user/Music
# LOCATION=New York, NY
# DJ_PERSONALITY=conversational
# KNOWLEDGE_DEPTH=moderate
# DEBUG=true
# LOG_LEVEL=DEBUG